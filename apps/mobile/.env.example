# Copy to apps/mobile/.env.local. EXPO_PUBLIC_* values are built into the app, so never put secrets here.
# Local development: the phone reaches the API on the computer running Expo, on this port.
EXPO_PUBLIC_API_PORT=3000
# Builds that talk to a deployed API instead (staging or production), for example https://api.example.com
# EXPO_PUBLIC_API_URL=
