{
  "expo": {
    "name": "SportsLink",
    "slug": "sportslink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportslink.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sportslink.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "sportslink",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SportsLink uses your photos to verify your identity.",
          "cameraPermission": "SportsLink uses your camera to photograph your ID for verification."
        }
      ],
      "expo-router"
    ]
  }
}
